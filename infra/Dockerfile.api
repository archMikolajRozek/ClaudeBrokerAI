FROM python:3.11-slim

WORKDIR /app

# Install API dependencies
COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Install common package dependencies
COPY packages/common/requirements.txt /app/packages/common/requirements.txt
RUN pip install --no-cache-dir -r /app/packages/common/requirements.txt

# Additional dependencies
RUN pip install --no-cache-dir \
    sqlalchemy==2.0.25 \
    asyncpg==0.29.0 \
    alembic==1.13.1

# Copy common package
COPY packages/common /app/packages/common

# Copy API code (will be mounted as volume in dev)
# COPY apps/api /app

# Dodaj packages do PYTHONPATH żeby import common działał
ENV PYTHONPATH=/app/packages
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
