FROM python:3.11-slim

WORKDIR /app

# Zainstaluj systemowe dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Kopiuj i zainstaluj COMMON requirements
COPY packages/common/requirements.txt /app/packages/common/requirements.txt
RUN pip install --no-cache-dir -r /app/packages/common/requirements.txt

# Zainstaluj dodatkowe dependencies które mogą być potrzebne przez agentów
RUN pip install --no-cache-dir \
    openai==1.10.0 \
    anthropic==0.18.0 \
    python-dotenv==1.0.0 \
    websockets==12.0 \
    aiohttp==3.9.1

# Kopiuj common package
COPY packages/common /app/packages/common

# Dodaj packages do PYTHONPATH żeby import common działał
ENV PYTHONPATH=/app/packages:$PYTHONPATH
ENV PYTHONUNBUFFERED=1

# Uruchom agenta z automatyczną instalacją agent-specific requirements
# Jeśli agent ma swój requirements.txt, zainstaluj go przed uruchomieniem
CMD ["/bin/bash", "-c", "if [ -f /app/agent/requirements.txt ]; then echo '[Agent] Installing requirements...'; pip install --no-cache-dir -r /app/agent/requirements.txt; fi && echo '[Agent] Starting main.py...' && python /app/agent/main.py"]
