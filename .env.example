# Redis Configuration
REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration
POSTGRES_DB=portfolio_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# AI API Keys (for news scoring)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Market Data API Keys
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
POLYGON_API_KEY=your-polygon-key
IEX_CLOUD_API_KEY=your-iex-cloud-key

# News API Keys
NEWS_API_KEY=your-newsapi-key

# Broker API Keys (Alpaca Paper Trading)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_API_SECRET=your-alpaca-api-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Risk Management Parameters
MAX_POSITION_SIZE=10000
MAX_PORTFOLIO_RISK=0.02
MAX_LEVERAGE=2.0

# Trading Parameters
TRADING_MODE=paper  # paper or live
MIN_SIGNAL_CONFIDENCE=0.6

# Ingest News Agent Configuration
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA
NEWS_FETCH_INTERVAL=300  # Seconds between news fetches (5 minutes)
NEWS_DAYS_BACK=1  # How many days back to fetch news

# Score News Agent Configuration
NEWS_DECAY_TAU_HOURS=24.0  # Decay half-life in hours (tau parameter)

# Strategy Agent Configuration
STRATEGY_ALPHA=0.6  # Weight for news score (0-1), (1-alpha) for momentum
STRATEGY_THRESHOLD=0.3  # Minimum combined score to generate signal
STRATEGY_RISK_REWARD=2.0  # Risk:Reward ratio (TP/SL)

# Risk Agent Configuration
RISK_NAV=10000.0  # Net Asset Value (starting capital)
RISK_MAX_PER_TRADE_PCT=0.005  # Max risk per trade (0.5% of NAV)
RISK_MAX_POSITIONS=5  # Max number of simultaneous positions
RISK_DAILY_LOSS_PCT=0.02  # Daily loss limit (2% of NAV)

# Shock Detector Agent Configuration
SHOCK_WINDOW_SIZE=20  # Sliding window size for z-score calculation
SHOCK_ZSCORE_THRESHOLD=2.0  # Z-score threshold (2 = 2 std deviations)
SHOCK_VOLUME_PERCENTILE=80.0  # Volume percentile threshold

# Cause Finder Agent Configuration
CAUSE_FINDER_TIME_WINDOW=30  # Minutes to look back for news
IMPACT_MEMORY_DB=impact_memory.db  # SQLite database path

# API Application Configuration
API_HOST=0.0.0.0
API_PORT=8000

# UI Application Configuration
API_BASE_URL=http://localhost:8000  # Backend API URL
