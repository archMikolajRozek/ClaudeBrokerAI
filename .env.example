# Redis Configuration
REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration
POSTGRES_DB=portfolio_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# AI API Keys (for news scoring)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Market Data API Keys
# Finazon.io - US STOCKS ESSENTIAL PLAN (~$29/mies, real-time 100+ US stocks, 5 req/min)
FINAZON_API_KEY=your-finazon-api-key

# News API Keys
NEWS_API_KEY=your-newsapi-key

# Broker API Keys - Interactive Brokers (PRIMARY)
# IBKR Paper Trading Account - https://www.interactivebrokers.com/
IBKR_USERNAME=your-ibkr-username  # Your IBKR account username
IBKR_PASSWORD=your-ibkr-password  # Your IBKR account password
IBKR_HOST=ib-gateway  # IB Gateway host (ib-gateway in Docker, localhost for local)
IBKR_PORT=4004  # INTERNAL Docker port: 4004 for paper, 4003 for live (host-mapped: 4002→4004, 4001→4003)
IBKR_CLIENT_ID=1  # Unique client ID (0-32)

# Broker API Keys - Alpaca Paper Trading (BACKUP - uncomment agent-execution-alpaca in docker-compose.yml)
# ALPACA_API_KEY=your-alpaca-api-key
# ALPACA_API_SECRET=your-alpaca-api-secret
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Risk Management Parameters
MAX_POSITION_SIZE=10000
MAX_PORTFOLIO_RISK=0.02
MAX_LEVERAGE=2.0

# Trading Parameters
TRADING_MODE=paper  # paper or live
MIN_SIGNAL_CONFIDENCE=0.6

# Ingest News Agent Configuration
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA
NEWS_FETCH_INTERVAL=300  # Seconds between news fetches (5 minutes)
NEWS_DAYS_BACK=1  # How many days back to fetch news

# Score News Agent Configuration
# WAŻNE dla INTRADAY: tau=24h jest ZA DŁUGIE dla tradingu dziennego
# Dla intraday używamy tau=0.5h (30 minut), bo newsy starsze niż 30 min tracą relevancję
NEWS_DECAY_TAU_HOURS=0.5  # Decay half-life in hours (tau parameter) - 0.5h dla intraday, 24.0h dla swing

# Strategy Agent Configuration
STRATEGY_ALPHA=0.6  # Weight for news score (0-1), (1-alpha) for momentum
STRATEGY_THRESHOLD=0.3  # Minimum combined score to generate signal
STRATEGY_RISK_REWARD=2.0  # Risk:Reward ratio (TP/SL)

# INTRADAY: Tighter stops dla szybkich transakcji (1% stop, 2% target)
STRATEGY_STOP_LOSS_PCT=0.01  # Stop loss % from entry (1% dla intraday, 2% dla swing)
STRATEGY_TAKE_PROFIT_PCT=0.02  # Take profit % from entry (2% dla intraday, 4% dla swing)

# Filtry wolumenu - WYMAGANE dla intraday (likwidność!)
MIN_DAILY_VOLUME=1000000  # Minimum średni dzienny wolumen (1M akcji)
MIN_DOLLAR_VOLUME=10000000  # Minimum wartość dzienna ($10M USD)
MAX_SPREAD_PCT=0.001  # Maksymalny spread bid-ask (0.1% = 10 bps)

# Filtry czasowe - sesja NYSE (Eastern Time)
MARKET_OPEN_HOUR=9  # Godzina otwarcia (9:30 EST faktycznie)
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16  # Godzina zamknięcia (16:00 EST)
MARKET_CLOSE_MINUTE=0
STOP_NEW_TRADES_HOUR=15  # Przestań otwierać nowe pozycje (15:50 EST)
STOP_NEW_TRADES_MINUTE=50
FORCE_CLOSE_HOUR=15  # Zamknij wszystkie pozycje (15:55 EST)
FORCE_CLOSE_MINUTE=55

# Risk Agent Configuration
RISK_NAV=500000.0  # Net Asset Value (starting capital) - IBKR Paper Trading: $1M available, using $500k
RISK_MAX_PER_TRADE_PCT=0.005  # Max risk per trade (0.5% of NAV)
RISK_MAX_POSITIONS=20  # Max number of simultaneous positions - zwiększone dla lepszej dywersyfikacji
RISK_DAILY_LOSS_PCT=0.02  # Daily loss limit (2% of NAV)

# Circuit Breaker Configuration
CIRCUIT_BREAKER_MAX_DRAWDOWN=0.10  # 10% max drawdown from peak

# Shock Detector Agent Configuration
SHOCK_WINDOW_SIZE=20  # Sliding window size for z-score calculation
SHOCK_ZSCORE_THRESHOLD=2.0  # Z-score threshold (2 = 2 std deviations)
SHOCK_VOLUME_PERCENTILE=80.0  # Volume percentile threshold

# Cause Finder Agent Configuration
CAUSE_FINDER_TIME_WINDOW=30  # Minutes to look back for news
IMPACT_MEMORY_DB=impact_memory.db  # SQLite database path

# API Application Configuration
API_HOST=0.0.0.0
API_PORT=8000

# UI Application Configuration
API_BASE_URL=http://localhost:8000  # Backend API URL

# Market Data Agent Configuration
# FINAZON.IO US STOCKS ESSENTIAL PLAN (real-time dla wszystkich US stocks)
MARKET_DATA_PROVIDER=finazon  # Używamy tylko Finazon (inne providery nieaktywne)
MARKET_DATA_UPDATE_INTERVAL=1200  # Sekundy między cyklami (1200s = 20 min, dopasowane do czasu fetchowania 100 tickerów)

# Finazon Ticker Filtering (dynamiczne pobieranie listy tickerów)
MAX_TICKERS=100  # Ile max tickerów monitorować - 100 tickerów = pełny obraz rynku
MIN_STOCK_PRICE=5.0  # Minimalna cena akcji (unikaj penny stocks < $5)
EXCHANGES=xnys,xnas  # Filtrowanie po giełdach (xnys=NYSE, xnas=NASDAQ)

# MATH: Rate limit Finazon /time_series = 5 req/min
# 100 tickerów ÷ 5 req/min = 20 minut na pełny cykl
# MARKET_DATA_UPDATE_INTERVAL=1200s = 20 min (perfect match!)
# Po zakończeniu cyklu, czekamy 20 min i startujemy od nowa

# Circuit Breaker Configuration
CIRCUIT_BREAKER_MAX_DRAWDOWN=0.10  # 10% max drawdown from peak NAV

# Momentum Agent Configuration
MOMENTUM_WINDOW_SIZE=50  # Ile świec używać do obliczenia wskaźników (50 bars = 50 minut dla 1-min)
MOMENTUM_RSI_PERIOD=14  # Okres dla RSI (standard 14)
MOMENTUM_MACD_FAST=12  # MACD fast EMA
MOMENTUM_MACD_SLOW=26  # MACD slow EMA
MOMENTUM_MACD_SIGNAL=9  # MACD signal line
